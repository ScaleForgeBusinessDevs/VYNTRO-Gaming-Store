# ==============================================================================
# VYNTRO Gaming Store — Environment Variables Example
# Duplicate this file as .env.local for local development or add these
# keys into your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Resend Email Integration (Optional - for order confirmations)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=orders@yourdomain.com

# Public Store URL (Update to your production Vercel domain e.g. https://vyntro.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
